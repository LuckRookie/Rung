  "oracle_source": "import json\nimport sys\nfrom batch import cancel_batch\nfrom http_api import cancel_http\nfrom orders import Order\nstates = [\"pending\", \"cancelled\", \"shipped\", \"delivered\"]\nallowed = {\"pending\", \"cancelled\"}\nif sys.argv[1] == \"followup\":\n    states.append(\"on_hold\")\n    allowed.add(\"on_hold\")\nchecks = []\nfor state in states:\n    accepted = state in allowed\n    expected_state = \"cancelled\" if accepted else state\n    for entry in [\"http\", \"batch\"]:\n        order = Order(7, state)\n        if entry == \"http\":\n            observed = cancel_http(order)\n            expected = (200, {\"id\": 7, \"state\": \"cancelled\"}) if accepted else (409, {\"id\": 7, \"error\": \"conflict\"})\n        else:\n            observed = cancel_batch([order])\n            expected = [{\"id\": 7, \"result\": \"cancelled\" if accepted else \"conflict\"}]\n        checks.append({\"entry\": entry, \"input\": state, \"expected\": expected, \"observed\": observed, \"state_after\": order.state, \"pass\": observed == expected and order.state == expected_state})\norders = [Order(20 - i, state) for i, state in enumerate(reversed(states))]\nexpected = [{\"id\": o.id, \"result\": \"cancelled\" if o.state in allowed else \"conflict\"} for o in orders]\nexpected_states = [\"cancelled\" if o.state in allowed else o.state for o in orders]\nobserved = cancel_batch(orders)\nchecks.append({\"entry\": \"mixed-batch\", \"expected\": expected, \"observed\": observed, \"pass\": observed == expected and [o.state for o in orders] == expected_states})\nprint(json.dumps({\"pass\": all(c[\"pass\"] for c in checks), \"checks\": checks}))\nsys.exit(0 if all(c[\"pass\"] for c in checks) else 1)\n"
}
