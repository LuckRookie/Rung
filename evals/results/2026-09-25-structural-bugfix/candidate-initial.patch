+    def cancel(self) -> bool:
+        """Cancel an eligible order, returning False without mutation on conflict."""
+        if self.state == "cancelled":
+            return True
+        if self.state != "pending":
+            return False
+        self.state = "cancelled"
+        return True
--- a/test_cancellation.py
