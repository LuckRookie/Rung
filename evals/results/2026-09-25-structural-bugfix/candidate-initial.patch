+    def test_batch_shipped(self):
+        order = Order(2, "shipped")
+        self.assertEqual(cancel_batch([order]), [{"id": 2, "result": "conflict"}])
+        self.assertEqual(order.state, "shipped")
+
+    def test_batch_mixed_preserves_order_and_states(self):
+        orders = [
+            Order(4, "shipped"),
+            Order(1, "pending"),
+            Order(3, "cancelled"),
+            Order(2, "delivered"),
+        ]
+        self.assertEqual(
+            cancel_batch(orders),
+            [
+                {"id": 4, "result": "conflict"},
+                {"id": 1, "result": "cancelled"},
+                {"id": 3, "result": "cancelled"},
+                {"id": 2, "result": "conflict"},
+            ],
+        )
+        self.assertEqual(
+            [order.state for order in orders],
+            ["shipped", "cancelled", "cancelled", "delivered"],
+        )
+
+    def test_http_delivered(self):
+        order = Order(2, "delivered")
+        self.assertEqual(cancel_http(order), (409, {"id": 2, "error": "conflict"}))
+        self.assertEqual(order.state, "delivered")
+
+    def test_unsupported_state_conflicts_without_mutation(self):
+        http_order = Order(5, "processing")
+        batch_order = Order(5, "processing")
+        self.assertEqual(
+            cancel_http(http_order), (409, {"id": 5, "error": "conflict"})
+        )
+        self.assertEqual(
+            cancel_batch([batch_order]), [{"id": 5, "result": "conflict"}]
+        )
+        self.assertEqual(http_order.state, "processing")
+        self.assertEqual(batch_order.state, "processing")
